## Either set DATABASE_URL directly OR define PG_* variables below and run: npm run gen-env
# DATABASE_URL will look like: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public

# Direct URL (optional if using PG_* vars):
DATABASE_URL=
## Optional separate test DB (used if set when running tests)
DATABASE_URL_TEST=

# Individual Postgres components (used by gen-env script if DATABASE_URL empty)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postbugt
PG_PASSWORD=admin123
PG_DB=bugtracker

JWT_ACCESS_SECRET=replace_with_strong_random_32_chars_min
JWT_REFRESH_SECRET=replace_with_strong_random_48_chars_minimum_here
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

