{
  "name": "bug-bounty-tracker-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "prisma": "prisma",
    "test": "node -r ./scripts/use-test-db.cjs ./node_modules/vitest/vitest.mjs run",
    "test:fast": "set PRISMA_MOCK=1 && set NODE_ENV=test && npx vitest",
    "test:unit": "node -r ./scripts/use-test-db.cjs ./node_modules/vitest/vitest.mjs run --dir test --exclude test/integration",
    "test:integration": "node ./scripts/run-integration.cjs",
    "test:coverage": "node -r ./scripts/use-test-db.cjs ./node_modules/vitest/vitest.mjs run --coverage",
    "test:ci": "prisma migrate deploy && NODE_ENV=test node -r ./scripts/use-test-db.cjs ./node_modules/vitest/vitest.mjs run --coverage",
    "gen-env": "tsx scripts/generate-env.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^1.10.2",
    "@prisma/client": "^5.17.0",
    "argon2": "^0.40.1",
    "bcrypt": "^5.1.1",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-raw-body": "^4.3.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.6",
    "otplib": "^12.0.1",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.2",
    "prom-client": "^14.1.1",
    "stripe": "^14.0.0",
  "zod": "^3.23.8",
  "@sentry/node": "^8.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^1.7.1",
    "prettier": "^3.2.5",
    "prisma": "^5.17.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
  "vitest": "^1.5.0"
  }
}
